    "inputs": { "image": "REPLACE_WITH_UPLOADED_NAME.png" }
  },
  "5": {
    "class_type": "ImageScaleToTotalPixels",
    "inputs": { "image": ["4", 0], "upscale_method": "nearest-exact", "megapixels": 1.0, "resolution_steps": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "clip": ["2", 0], "text": "REPLACE_WITH_COMPILED_PROMPT" }
  },
  "7": {
    "class_type": "ConditioningZeroOut",
    "inputs": { "conditioning": ["6", 0] }
  },
  "8": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["5", 0], "vae": ["3", 0] }
  },
  "9": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["6", 0], "latent": ["8", 0] }
  },
  "10": {
    "class_type": "ReferenceLatent",
    "inputs": { "conditioning": ["7", 0], "latent": ["8", 0] }
  },
  "11": {
    "class_type": "EmptyFlux2LatentImage",
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 }
  },
  "12": {
    "class_type": "Flux2Scheduler",
    "inputs": { "steps": 4, "width": 1024, "height": 1024 }
  },
  "13": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "euler" }
  },
  "14": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 }
  },
  "15": {
    "class_type": "CFGGuider",
    "inputs": { "model": ["1", 0], "positive": ["9", 0], "negative": ["10", 0], "cfg": 1.0 }
  },
  "16": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["14", 0],
      "guider": ["15", 0],
      "sampler": ["13", 0],
      "sigmas": ["12", 0],
      "latent_image": ["11", 0]
    }
  },
  "17": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["16", 0], "vae": ["3", 0] }
  },
  "18": {
    "class_type": "SaveImage",
    "inputs": { "images": ["17", 0], "filename_prefix": "fifteen-minutes" }
  }
}
