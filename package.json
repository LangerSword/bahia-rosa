{
  "name": "night-desk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Your photo, printed by the city — then your poster takes the city. A GTA VI-inspired experience built for the Unlayer Build with React Image Editor Challenge.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desk": "bash tools/desk/desk.sh start",
    "desk:stop": "bash tools/desk/desk.sh stop",
    "desk:status": "bash tools/desk/desk.sh status",
    "desk:logs": "bash tools/desk/desk.sh logs 60",
    "tunnel": "bash tools/desk/tunnel.sh start",
    "desk:aws": "bash tools/desk/aws.sh",
    "print": "node tools/print-desk/print.mjs",
    "scenery": "node tools/print-desk/scenery.mjs",
    "harness": "node tools/print-desk/harness.mjs",
    "frame": "$HOME/.venv/bin/python tools/print-desk/frame.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@unlayer/react-image-editor": "^1.0.2",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
